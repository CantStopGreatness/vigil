{
  "manifest_version": 3,
  "name": "Vigil: Website Security Grade",
  "version": "0.1.0",
  "description": "Grade the site you're on in seconds: security headers, TLS, cookies, known CVEs and email spoofing, with a fix for every finding.",
  "action": {
    "default_title": "Grade this site with Vigil",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab"],
  "host_permissions": ["https://vigil-psi-liard.vercel.app/*"]
}
